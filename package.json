{
  "name": "saucedemo-e2e",
  "version": "1.0.0",
  "description": "Projeto de automação E2E com Playwright e TypeScript para a aplicação SauceDemo",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:login": "playwright test tests/login.spec.ts",
    "test:inventory": "playwright test tests/inventory.spec.ts",
    "test:cart": "playwright test tests/cart.spec.ts",
    "test:checkout": "playwright test tests/checkout.spec.ts",
    "report": "playwright show-report reports",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}